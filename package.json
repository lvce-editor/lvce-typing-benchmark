{
  "name": "lvce-typing-benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "node src/analyzeCli.ts",
    "benchmark": "npm run setup && node src/main.ts",
    "benchmark:ci": "node src/runCiBenchmark.ts",
    "benchmark:render": "npm run setup && node src/renderMain.ts",
    "benchmark:render:ci": "node src/runCiRenderBenchmark.ts",
    "benchmark:startup": "npm run setup && node src/startupMain.ts",
    "benchmark:startup:ci": "node src/runCiStartupBenchmark.ts",
    "ci:report": "node src/generateCiReport.ts",
    "install-browser:ci": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "report": "node src/reportCli.ts",
    "report:render": "node src/renderReportCli.ts",
    "report:startup": "node src/startupReportCli.ts",
    "setup": "node src/setup.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:fixtures": "node --test browser-test/*.test.ts",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@github1s/vscode-web": "0.30.2",
    "@lvce-editor/editor-worker": "19.69.1",
    "@lvce-editor/renderer-process": "30.58.3",
    "@lvce-editor/rpc": "6.19.3",
    "@lvce-editor/server": "0.119.6",
    "@lvce-editor/static-server": "0.119.6",
    "@lvce-editor/syntax-highlighting-worker": "2.5.1",
    "@lvce-editor/virtual-dom": "11.19.0",
    "ace-builds": "1.44.0",
    "codejar": "4.3.0",
    "codemirror": "6.0.2",
    "codemirror5": "npm:codemirror@5.65.21",
    "monaco-editor": "0.56.0",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.10.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/codemirror5": "npm:@types/codemirror@5.60.18",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/prismjs": "1.26.6",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "rollup": "^4.63.1",
    "rollup-plugin-css-only": "^4.5.5",
    "typescript": "^6.0.3"
  }
}
